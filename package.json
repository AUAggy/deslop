{
  "name": "deslop",
  "displayName": "DeSlop - AI Slop Remover",
  "description": "Rewrites AI-generated prose into clear technical writing. Removes slop vocabulary, padding phrases, decorative emojis, and cliche structures from READMEs, docstrings, commit messages, and blog posts. Works with OpenRouter and Venice.ai. Any model, your API key.",
  "version": "0.1.9",
  "publisher": "AUAggy",
  "repository": {
    "type": "git",
    "url": "https://github.com/AUAggy/deslop"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "ai",
    "slop",
    "prose",
    "writing",
    "documentation",
    "readme",
    "humanizer",
    "llm",
    "chatgpt",
    "copilot",
    "rewrite",
    "editing",
    "technical writing",
    "ai writing",
    "deSlop",
    "venice",
    "openrouter",
    "grok"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:deslop.humanizeSelection",
    "onCommand:deslop.resetApiKey",
    "onCommand:deslop.showChanges"
  ],
  "main": "./dist/extension",
  "contributes": {
    "commands": [
      {
        "command": "deslop.humanizeSelection",
        "title": "DeSlop Selection",
        "category": "DeSlop"
      },
      {
        "command": "deslop.resetApiKey",
        "title": "Replace API Key",
        "category": "DeSlop"
      },
      {
        "command": "deslop.showChanges",
        "title": "Show Last Changes",
        "category": "DeSlop"
      },
      {
        "command": "deslop.manageConnection",
        "title": "Manage Connection",
        "category": "DeSlop"
      },
      {
        "command": "deslop.disconnectProvider",
        "title": "Disconnect Provider",
        "category": "DeSlop"
      },
      {
        "command": "deslop.returnToOperation",
        "title": "Return to Active Operation",
        "category": "DeSlop"
      },
      {
        "command": "deslop.cancelOperation",
        "title": "Cancel Operation",
        "category": "DeSlop"
      },
      {
        "command": "deslop.copyResult",
        "title": "Copy Completed Result",
        "category": "DeSlop"
      },
      {
        "command": "deslop.changeDocumentType",
        "title": "Change Document Type",
        "category": "DeSlop"
      },
      {
        "command": "deslop.changeModel",
        "title": "Change Model",
        "category": "DeSlop"
      },
      {
        "command": "deslop.configureEditorialPreferences",
        "title": "Configure Editorial Preferences",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.applySelected",
        "title": "Apply Selected Changes",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.acceptAll",
        "title": "Accept Full Rewrite",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.discard",
        "title": "Discard Rewrite",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.return",
        "title": "Return to Review",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.selectGroups",
        "title": "Select Change Groups",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.selectAll",
        "title": "Select All Change Groups",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.selectNone",
        "title": "Clear Selected Groups",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.showChanges",
        "title": "Show Current Changes",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.showFullProposal",
        "title": "Inspect Full Proposal",
        "category": "DeSlop"
      },
      {
        "command": "deslop.review.copyResult",
        "title": "Copy Reviewed Result",
        "category": "DeSlop"
      }
    ],
    "keybindings": [
      {
        "command": "deslop.humanizeSelection",
        "key": "shift+alt+d",
        "mac": "shift+alt+d",
        "when": "editorHasSelection && editorTextFocus"
      },
      {
        "command": "deslop.review.applySelected",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "deslop.reviewActive && !inQuickOpen"
      },
      {
        "command": "deslop.review.discard",
        "key": "escape",
        "when": "deslop.reviewActive && !inQuickOpen"
      },
      {
        "command": "deslop.review.selectGroups",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "deslop.reviewActive && !inQuickOpen"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "deslop.humanizeSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "deslop.review.applySelected",
          "when": "deslop.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "deslop.review.selectGroups",
          "when": "deslop.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "deslop.review.showChanges",
          "when": "deslop.reviewActive",
          "group": "navigation@3"
        },
        {
          "command": "deslop.review.discard",
          "when": "deslop.reviewActive",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "DeSlop",
      "properties": {
        "deslop.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "venice"
          ],
          "default": "openrouter",
          "description": "AI provider. openrouter: uses openrouter.ai (default model: openai/gpt-6-luna). venice: uses venice.ai (default model: openai-gpt-6-luna). Each provider requires its own API key."
        },
        "deslop.model": {
          "type": "string",
          "default": "openai/gpt-6-luna",
          "description": "Model ID for the selected provider. When unset, uses openai/gpt-6-luna on OpenRouter or openai-gpt-6-luna on Venice. Explicit model settings take precedence."
        },
        "deslop.defaultDocumentType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "README",
            "Docstring/Comment",
            "Commit Message",
            "Blog/Article"
          ],
          "default": null,
          "description": "Explicit type takes precedence; otherwise infer recognised README/comment/commit contexts, reuse last choice only when enabled, or ask."
        },
        "deslop.showChangeLog": {
          "type": "boolean",
          "default": false,
          "description": "Show model explanations after application. Off by default; Show Current Changes and Show Last Changes remain available. Existing explicit user choices are preserved; workspace overrides are ignored."
        },
        "deslop.autoAccept": {
          "type": "boolean",
          "default": false,
          "description": "Skip diff view and replace text immediately. (User-scope only; workspace overrides are ignored for safety.)"
        },
        "deslop.preservePunctuationStyle": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Ask the model to retain legitimate punctuation style. Not a mechanical guarantee; meaning and output integrity take precedence. User scope only; changes affect new requests, not existing results."
        },
        "deslop.preserveParagraphListStructure": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Ask the model to retain paragraph and list organisation. Not an exact formatting or meaning guarantee. User scope only; changes affect new requests, not existing results."
        },
        "deslop.rememberDocumentType": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Reuse the last explicitly selected document type when no explicit default or high-confidence context applies. Otherwise the last choice only changes picker ordering. User scope only; changes affect new requests, not existing results."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "tsc -p ./",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext .ts",
    "test": "vscode-test",
    "test:workflow": "node scripts/test-workflow.cjs",
    "test:connections": "node src/test/connections.integration.cjs",
    "test:review": "node node_modules/mocha/bin/mocha.js --ui tdd out/test/suite/reviewPatch.test.js out/test/suite/reviewUi.test.js",
    "test:editorial": "node --test evaluation/assets.test.cjs evaluation/editorial.test.cjs",
    "test:contracts": "node scripts/test-integration-contracts.cjs",
    "test:sdk-privacy": "node scripts/test-sdk-privacy.cjs",
    "test:deterministic": "npm run compile && npm run lint && npm run test:workflow && npm run test:connections && npm run test:review && npm run test:editorial && npm run test:contracts && npm run test:sdk-privacy",
    "posttest": "sh scripts/unregister-vscode-test.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "openai": "^6.33.0"
  }
}
